rule o365_entra_id_app_creation_followed_by_secret_modification {

  meta:
    author = "Gowthaman"
    description = "Detects Entra ID application creation followed by client secret addition/update within a short time window. Indicates potential persistence establishment."
    type = "alert"
    platform = "azure"
    data_source = "o365"
    severity = "High"
    priority = "High"
    mitre_attack_tactic = "Persistence"
    mitre_attack_technique = "Account Manipulation: Additional Cloud Credentials"
    mitre_attack_technique_id = "T1098.001"

  events:

    // Event 1: Application Creation
    $create.metadata.event_type = "USER_RESOURCE_CREATION"
    $create.metadata.product_name = "Office 365"
    $create.metadata.vendor_name = "Microsoft"
    $create.metadata.product_event_type = "Add application."
    $create.security_result.action = "ALLOW"
    $create.principal.user.userid = $userid

    // Event 2: Secret Add / Update / Delete
    $secret.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"
    $secret.metadata.product_name = "Office 365"
    $secret.metadata.vendor_name = "Microsoft"
    $secret.metadata.product_event_type = /Update application.*Certificates and secrets management/
    $secret.security_result.action = "ALLOW"
    $secret.principal.user.userid = $userid

    $create.target.resource.name = $secret.target.resource.name
    $create.metadata.event_timestamp.seconds  < $secret.metadata.event_timestamp.seconds     

not (
      strings.coalesce($create.target.resource.name, "") = /(?i)^Google Chronical Logs/ or
      strings.coalesce($create.target.resource.name, "") = /(?i)^BF vCenter/ or
      strings.coalesce($create.target.resource.name, "") = /(?i)Defect Dojo/ or
      strings.coalesce($create.target.resource.name, "") = /(?i)^Aidence/ or
      strings.coalesce($create.target.resource.name, "") = /(?i)Grafana/ or
      strings.coalesce($create.target.resource.name, "") = /(?i)^QRADAR/ or
      strings.coalesce($create.target.resource.name, "") = /(?i)ArgoCD/ or
      strings.coalesce($create.target.resource.name, "") = /(?i)Ketryx/ 
)
  match:
    $userid over 30m

  outcome:
    $risk_score = 85
    $creation_event_count = count_distinct($create.metadata.id)
    $secret_event_count = count_distinct($secret.metadata.id)
    $principal_user_userid = array_distinct($userid)
    $created_application_names = array_distinct($create.target.resource.name)
    $app_creation_user_agent = array_distinct($create.network.http.user_agent)
    $secret_update_user_agent =array_distinct($secret.network.http.user_agent)  
    $target_entra_id_application = array_distinct(re.capture($create.network.http.user_agent,`\"AppId\":\"(.*)`))
   

  condition:
    $create and $secret
}
